{
  "name": "habitat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "probe": "tsx scripts/probe.ts",
    "conformance": "tsx scripts/generate-conformance-ledger.ts",
    "conformance:check": "tsx scripts/generate-conformance-ledger.ts --check",
    "gate": "npm test && npm run build && npm run conformance:check && npm run probe -- --all --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.1",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
